{
  // Сниппеты проекта: VS Code подхватывает файл *.code-snippets из .vscode сам.
  // Печатаете префикс (acme-…) → Tab. Разметка блоков — каноническая, как сохраняет редактор:
  // вставленная в шаблон или паттерн, она не станет «недействительным блоком».

  "Секция страницы (core/group)": {
    "scope": "html,php",
    "prefix": "acme-section",
    "body": [
      "<!-- wp:group {\"tagName\":\"section\",\"className\":\"acme-section${1: is-sunken}\"} -->",
      "<section class=\"wp-block-group acme-section${1: is-sunken}\"><!-- wp:group {\"className\":\"acme-wrap\"} -->",
      "<div class=\"wp-block-group acme-wrap\"><!-- wp:heading -->",
      "<h2 class=\"wp-block-heading\">${2:Заголовок секции}</h2>",
      "<!-- /wp:heading -->",
      "",
      "$0</div>",
      "<!-- /wp:group --></section>",
      "<!-- /wp:group -->",
    ],
    "description": "Секция section.acme-section > div.acme-wrap с заголовком H2",
  },
  "Абзац (core/paragraph)": {
    "scope": "html,php",
    "prefix": "acme-p",
    "body": ["<!-- wp:paragraph -->", "<p>$0</p>", "<!-- /wp:paragraph -->"],
    "description": "Абзац",
  },
  "Лид (core/paragraph.acme-lead)": {
    "scope": "html,php",
    "prefix": "acme-lead",
    "body": [
      "<!-- wp:paragraph {\"className\":\"acme-lead\"} -->",
      "<p class=\"acme-lead\">$0</p>",
      "<!-- /wp:paragraph -->",
    ],
    "description": "Лид под заголовком: первый абзац — прямой ответ на главный вопрос страницы",
  },
  "Кнопки (core/buttons)": {
    "scope": "html,php",
    "prefix": "acme-buttons",
    "body": [
      "<!-- wp:buttons -->",
      "<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-${1|primary,secondary,ghost|}\"} -->",
      "<div class=\"wp-block-button is-style-${1}\"><a class=\"wp-block-button__link wp-element-button\" href=\"${2:#form}\">${3:Текст кнопки}</a></div>",
      "<!-- /wp:button --></div>",
      "<!-- /wp:buttons -->",
    ],
    "description": "Кнопка со стилем дизайн-системы",
  },
  "Список «Факты» (core/list)": {
    "scope": "html,php",
    "prefix": "acme-facts",
    "body": [
      "<!-- wp:list {\"className\":\"is-style-facts\"} -->",
      "<ul class=\"wp-block-list is-style-facts\"><!-- wp:list-item -->",
      "<li>${1:Пункт}</li>",
      "<!-- /wp:list-item --></ul>",
      "<!-- /wp:list -->",
    ],
    "description": "Список с галочками",
  },
  "Вопросы и ответы (FAQPage)": {
    "scope": "html,php",
    "prefix": "acme-faq",
    "body": [
      "<!-- wp:group {\"className\":\"acme-faq\"} -->",
      "<div class=\"wp-block-group acme-faq\"><!-- wp:details -->",
      "<details class=\"wp-block-details\"><summary>${1:Вопрос}</summary><!-- wp:paragraph -->",
      "<p>${2:Короткий ответ по делу.}</p>",
      "<!-- /wp:paragraph --></details>",
      "<!-- /wp:details --></div>",
      "<!-- /wp:group -->",
    ],
    "description": "Группа .acme-faq с core/details: плагин строит из неё разметку FAQPage",
  },
  "Блок темы в разметке": {
    "scope": "html,php",
    "prefix": "acme-block",
    "body": ["<!-- wp:acme/${1:cards} ${2:{\\}} /-->"],
    "description": "Динамический блок темы (атрибуты — JSON)",
  },
  "render.php блока": {
    "scope": "php",
    "prefix": "acme-render",
    "body": [
      "<?php",
      "/**",
      " * ${1:Что выводит блок, откуда данные, атрибуты.}",
      " */",
      "",
      "defined( 'ABSPATH' ) || exit;",
      "",
      "\\$acme_${2:title} = (string) ( \\$attributes['${2}'] ?? '' );",
      "if ( '' === \\$acme_${2} ) {",
      "\treturn;",
      "}",
      "?>",
      "<section class=\"acme-section acme-${3:name}\">",
      "\t<div class=\"acme-wrap\">",
      "\t\t<h2><?php echo esc_html( \\$acme_${2} ); ?></h2>",
      "\t\t$0",
      "\t</div>",
      "</section>",
    ],
    "description": "Заготовка render.php (новый блок целиком — node wordpress/tools/new-block.js)",
  },
  "Подпись интерфейса": {
    "scope": "php",
    "prefix": "acme-t",
    "body": ["<?php acme_e( '${1:key}' ); ?>"],
    "description": "Текст интерфейса на языке страницы (ключ — project/content/site.js → strings)",
  },
  "Подпись в атрибуте": {
    "scope": "php",
    "prefix": "acme-ta",
    "body": ["<?php echo esc_attr( acme_t( '${1:key}' ) ); ?>"],
    "description": "Текст интерфейса внутри атрибута (aria-label, title)",
  },
  "Поле записи в схеме": {
    "scope": "php",
    "prefix": "acme-field",
    "body": [
      "'acme_${1:key}' => array( '${2|string,integer,boolean,date,service,post|}', '${3:Подпись поля}' ),",
    ],
    "description": "Строка для acme_meta_schema(): поле появится в панели редактора само",
  },
  "Хук WordPress с функцией": {
    "scope": "php",
    "prefix": "acme-hook",
    "body": [
      "// ${1:Зачем этот хук.}",
      "add_${2|action,filter|}(",
      "\t'${3:init}',",
      "\tfunction (${4: \\$value }) {",
      "\t\t$0",
      "\t}",
      ");",
    ],
    "description": "add_action / add_filter с комментарием «зачем»",
  },
  "Раздел стилей": {
    "scope": "css",
    "prefix": "acme-css",
    "body": ["/* ---------- ${1:Название раздела} ---------- */", ".acme-${2:name} {", "\t$0", "}"],
    "description": "Раздел в style.css блока (blocks/<имя>/) или в общем файле assets/css",
  },
  "Медиазапрос (мобильный)": {
    "scope": "css",
    "prefix": "acme-mq",
    "body": ["@media (max-width: ${1|479.98,759.98,859.98,1023.98|}px) {", "\t$0", "}"],
    "description": "Брейкпоинты проекта (.98 — без «дыры» в 1 px)",
  },
  "Инициализация в site.js": {
    "scope": "javascript",
    "prefix": "acme-init",
    "body": [
      "// ${1:Что делает}. Работает и в превью редактора: once() не даёт навесить слушатели дважды.",
      "queryAllWithRoot('[data-acme-${2:name}]', root).forEach((element) => {",
      "\tif (!once(element, '${2}')) {",
      "\t\treturn;",
      "\t}",
      "\t$0",
      "});",
    ],
    "description": "Раздел внутри init( root ) в assets/js/site.js",
  },
}
