# Ключи ручного деплоя (wordpress/deploy/manual.sh). Скопируйте в manual-production.env или manual-test.env
# рядом с этим файлом и заполните. Файлы manual-*.env в git не попадают — пароли храните только в них.
# Значения — те же, что в секретах GitHub (Settings → Environments → production / test).
# Формат — как в shell: без пробелов вокруг «=», значение с пробелами или спецсимволами — в 'одинарных кавычках'.

# SSH-доступ к хостингу
SSH_HOST=
SSH_USER=
SSH_PORT=22
# Путь к приватному ключу, без пробелов. Пусто — ssh возьмёт ключ по умолчанию или спросит пароль.
SSH_KEY_FILE=

# Сайт на хостинге
# Полный путь к папке WordPress, например /home/u/user/acme.example/public_html
DEPLOY_PATH=
# Адрес без слэша в конце, например https://acme.example — ровно как в настройках WordPress
SITE_URL=
# Путь к PHP 8.3+, если на хостинге не находится сам (например /usr/local/bin/php8.3)
PHP_BIN=
# 1 — закрыть боевой сайт от поисковиков
NOINDEX=0
# Кеш страниц: пусто — включён, 0 — выключить
PAGE_CACHE=
# Автообновление плагинов: 1 — включить, 0 — выключить, пусто — не трогать (по умолчанию выключено)
AUTO_UPDATE_PLUGINS=

# Необязательно: копии заявок в Telegram (пусто — настройки на сайте не меняются)
TG_BOT_TOKEN=
TG_CHAT_ID=

# Нужны только для первой установки WordPress в пустую папку — для обновления сайта не заполняйте
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_EMAIL=
