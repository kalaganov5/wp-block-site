{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "acme/lead-form",
	"title": "Форма заявки",
	"category": "acme",
	"description": "Форма Contact Form 7 на языке страницы с заголовком и подзаголовком.",
	"textdomain": "acme",
	"attributes": {
		"title": { "type": "string", "default": "" },
		"sub": { "type": "string", "default": "" },
		"formId": { "type": "integer", "default": 0 }
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"reusable": false
	},
	"editorScript": "acme-editor",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
