{
  "name": "acme/site",
  "description": "Инструменты разработки Acme Site: PHPCS. На сервер не попадает — тема и плагин работают без composer.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "slevomat/coding-standard": "^8.15"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
